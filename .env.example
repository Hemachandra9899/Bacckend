PORT=5000
NODE_ENV=development

# Render Keep-Alive Configuration
KEEP_ALIVE_URL=https://portfolio-bacckend.onrender.com
RENDER_EXTERNAL_URL=https://portfolio-bacckend.onrender.com

# NVIDIA LLM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FAST_MODEL=meta/llama-3.2-11b-vision-instruct

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=portfolio-free

# CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://portfolio-omega-vert-ehkt9x89mo.vercel.app
